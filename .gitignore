.env
venv/
__pycache__/
*.pyc
db.sqlite3
staticfiles/
FETCH_HEAD

# Never commit — sensitive files
prod_settings.json
publish_profile.xml
local_settings.json
*.publishsettings

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfplan
terraform/.terraform.lock.hcl
terraform/terraform.tfvars

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfplan
terraform/terraform.tfvars
packages/
terraform/plan-output.txt
terraform/tfplan

# Terraform state and vars — never commit real secrets
terraform/terraform.tfvars
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfstate.*.backup

# Terraform local artifacts — auto.tfvars may contain secrets, tfplan-restore is a plan/state artifact
terraform/*.auto.tfvars
terraform/tfplan-restore
