@startuml C4 Container Diagram
!theme plain
!include lib/C4_Container.puml

title C4 Container Diagram - Django Azure Security Template

LAYOUT_WITH_LEGEND()

Person(user, "Authenticated User", "Browser via HTTPS 443 - Entra ID / Google OAuth2")
Person(devops, "DevOps Engineer", "GitHub Codespaces - git push to develop branch")

System_Ext(entra, "Microsoft Entra External ID CIAM", "OAuth2 / OIDC Identity provider")
System_Ext(github, "GitHub Actions", "DevSecOps CI/CD pipeline - 7 jobs: SAST to DAST to Deploy")
System_Ext(sentinel, "Microsoft Sentinel", "SIEM - 3 Analytics Rules + Data Connector")
System_Ext(defender, "Defender for App Service", "Kernel-level detection - NMap scan detected 2026-06-26")

System_Boundary(azure, "Azure - rg-django-azure-staging") {

    Container(app, "Django App", "Python 3.12 / Django 6 / Gunicorn / App Service Linux B1",
        "Zero Trust middleware + HTMX - Security + FinOps + Analytics dashboards")

    Container(kv, "Azure Key Vault", "Key Vault - Private Endpoint (kv-subnet)",
        "Stores CLIENT_ID, CLIENT_SECRET, DATABASE_URL, SECRET_KEY")

    ContainerDb(pg, "PostgreSQL", "Azure PostgreSQL Flexible Server - Private Endpoint (data-subnet)",
        "Django sessions and user model")

    Container(otel, "Application Insights", "OpenTelemetry + AzureMonitorLogExporter + JS SDK",
        "AppTraces, AppRequests, AppMetrics, AppPageViews, AppBrowserTimings")

    ContainerDb(law, "Log Analytics Workspace", "law-django-azure-staging",
        "AppTraces - AppPageViews - AppBrowserTimings - SecurityAlert - SecurityIncident")

    Container(vnet, "VNet + NSG", "10.0.0.0/16 - NSG: Allow 443, Deny All",
        "3 subnets: app/data/kv - Private Endpoints for KV + PG")
}

System_Boundary(dashboards, "HTMX Dashboards - django-htmx 1.27.0") {

    Container(security_dash, "Security Dashboard /security/", "D3.js v7 + HTMX",
        "MITRE ATT&CK force graph - 20 techniques x 9 tactics - Live Defender for Cloud alerts")

    Container(finops_dash, "FinOps Dashboard /finops/", "Chart.js 4.4 + HTMX",
        "Cost Management API via MSI - Daily trend + RG breakdown - 13/month MTD July 2026")

    Container(analytics_dash, "Analytics Dashboard /analytics/", "Chart.js 4.4 + HTMX",
        "AppPageViews + AppBrowserTimings - Real User Monitoring RUM - JS Exceptions tracking")
}

note right of app
  System-Assigned MSI Roles:
  Key Vault Secrets User
  Cost Management Reader
  Security Reader
  Log Analytics Reader
end note

Rel(user, app, "HTTPS 443", "TLS 1.2+")
Rel(devops, github, "git push develop", "triggers pipeline")
Rel(github, app, "zip deploy", "Oryx build + startup.sh")

Rel(app, entra, "OAuth2 PKCE", "HTTPS")
Rel_Back(app, entra, "access_token + id_token", "HTTPS")

Rel(app, kv, "MSI secret read", "Private EP HTTPS")
Rel(app, pg, "SQL queries", "Private EP port 5432")
Rel(app, otel, "OpenTelemetry logs", "BatchLogRecordProcessor")
Rel(otel, law, "ingestion", "HTTPS")
Rel(law, sentinel, "KQL analytics", "PT5M + PT1H")
Rel(defender, law, "SecurityAlert", "AzureSecurityCenter connector")

Rel(app, security_dash, "serves", "HTMX partial")
Rel(app, finops_dash, "serves", "HTMX partial")
Rel(app, analytics_dash, "serves", "HTMX partial")

Rel(analytics_dash, law, "Log Analytics Query", "MSI token AppPageViews + AppBrowserTimings")

Rel(user, security_dash, "views", "HTTPS")
Rel(user, finops_dash, "views", "HTTPS")
Rel(user, analytics_dash, "views", "HTTPS")

@enduml
